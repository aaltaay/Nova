# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
# electron-builder's buildResources: the app icon lives here (source, not output)
!frontend/electron/build/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.local

# Ephemeral agent scratch (screenshots, browser dumps -- never commit)
.tmp/
# ...and the screenshots / a11y-snapshot dumps that piled up in frontend/'s root
# (22 PNGs + snapf/snapg.txt, removed 2026-09-22). Anchored: public/ and src/assets keep theirs.
/frontend/*.png
/frontend/snap*.txt

# Generated build artifact (tools/bump_version.py --sync); never committed -- see #344
/VERSION
.tmp_snapshot*.txt

# Local browser auth exports (cookies/localStorage) — never commit
.local/

# Scanner persistence cache (in-process snapshots, not for VCS)
backend/.cache/
# tools/data_root.py move: the C: original, removed once its F: copy is verified
backend/.cache.moved-*/
backend/logs.moved-*/

# Runtime log files
backend/logs/

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/release/
frontend/dist-electron/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
# Vite's dependency cache, one per checkout (vite.config.ts cacheDir)
frontend/.vite-cache/

# PyInstaller / desktop sidecar
backend/dist/
backend/build/
backend/*.spec.bak

# OS
.DS_Store
Thumbs.db
.vercel

# Local course handouts (large PDFs / videos — keep on disk, do not push)
downloads/

# Vale synced style packages (keep Vocab committed)
.vale/styles/**
!.vale/styles/Vocab/
!.vale/styles/Vocab/**

# Graphify extraction cache / scratch (keep graph.json, report, wiki, html in VCS)
# Never write a second graph under the vault (CLI mis-target); canonical is repo-root graphify-out/
knowledge/obsidian/graphify-out/

# Dated accidental rebuilds under graphify-out/YYYY-MM-DD/ (canonical is graphify-out/ root)
graphify-out/20*/

graphify-out/cache/
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic*.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_cached.json
graphify-out/.graphify_uncached.txt
graphify-out/.needs_update
graphify-out/*.bak
graphify-out/usage.json
graphify-out/memory/

# Mis-targeted graphify runs under backend/ or frontend/ (canonical is repo-root graphify-out/)
backend/graphify-out/
frontend/graphify-out/
frontend/src/graphify-out/cache/
frontend/src/graphify-out/.graphify_*
frontend/src/graphify-out/.needs_update

# pytest cache (local scratch, not for VCS)
.pytest_cache/

# Local desktop launcher binary (rebuild via tools/nova-launcher)
Nova.exe
Nova.repo
tools/nova-launcher/bin/
tools/nova-launcher/obj/


# Runtime logs written by the local API / desktop sidecar (root-level).
# backend/logs/ is already covered above; this is the repo-root sibling.
logs/

# One-off sim bar captures (e.g. soun_bars.json) written locally for replay
# experiments. Owner: backend/sim. Never committed -- WS5 of #344.
backend/sim/data/

# Claude Code scratch worktrees (isolation: worktree). Registered with git but
# never part of the tree; `py -3 tools/repo_hygiene.py fix` reclaims stale ones.
.claude/worktrees/

# Generated research outputs are local-only.
/graphify-out/
