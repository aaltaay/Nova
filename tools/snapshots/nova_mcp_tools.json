    "inputSchema": {
      "properties": {
        "filters": {
          "additionalProperties": true,
          "title": "Filters",
          "type": "object"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "kinds": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kinds"
        },
        "splits": {
          "default": "exclude_likely",
          "title": "Splits",
          "type": "string"
        },
        "float_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Float Max"
        },
        "float_basis": {
          "default": "sec_outstanding",
          "title": "Float Basis",
          "type": "string"
        },
        "float_unknown": {
          "default": "exclude",
