# Copy to .env.local for local overrides (never commit .env.local).
# Local default: API on loopback. Backend is not cloud-hosted right now.
# Local default: API on loopback. Backend is not cloud-hosted.
# nova.altaystudio.com is the marketing page in repo `site/`, not this Vite app.

# Public API base (no trailing slash). Local:
VITE_API_BASE_URL=http://localhost:8000
# Optional alias used by some build scripts:
# NOVA_API_BASE=http://localhost:8000

# Must match backend NOVA_API_KEY when that env is set (sent as X-Nova-Api-Key).
# Leave unset for local loopback APIs that do not require a key.
#VITE_NOVA_API_KEY=

# Backend-side (local .env, not here): restrict CORS if a non-localhost UI origin
# must call the API.
# NOVA_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
