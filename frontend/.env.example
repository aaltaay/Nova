# Copy to .env.local for local overrides (never commit .env.local).
# In production (Railway / Vercel) set this as an environment variable.

# Public HTTPS URL of the Railway backend service (no trailing slash).
# Example: https://stock-alert-backend.up.railway.app
# Railway can reference another service:
#   https://${{Backend.RAILWAY_PUBLIC_DOMAIN}}
# Optional alias (same value) for builds where only non-VITE_ vars are passed:
# NOVA_API_BASE=https://your-backend.up.railway.app
VITE_API_BASE_URL=http://localhost:8000
