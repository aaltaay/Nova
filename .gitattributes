# Workflow scripts are read verbatim by the Workflow tool, which rejects the
# CR in a CRLF line ending as a control character. Keep them LF on every
# platform so a Windows checkout can still launch them.
.claude/workflows/*.js text eol=lf

# Merge policy for the remaining prepend-only log.
# Two PRs authored in parallel collide at line 1 on it, on paperwork rather
# than on code -- see #344 "the structural problem".
#
# `merge=union` keeps BOTH sides instead of raising a conflict. That is the
# right outcome here: two independent log entries are additive, and losing one
# silently would be worse than a conflict.
#
# Union merging is only safe for append/prepend-only logs. Never add it to a
# file where two edits could interleave into something meaningless.
knowledge/task-log/INDEX.md merge=union
