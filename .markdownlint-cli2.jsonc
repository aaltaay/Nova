{
  "ignores": [
    "node_modules/**",
    "frontend/node_modules/**",
    ".git/**",
    "**/graphify-out/**",
    "frontend/dist/**",
    "frontend/release/**",
    "backend/.cache/**",
    "backend/logs/**",
    ".vale/**",
    "**/.tmp/**",
    "downloads/**",
    "**/test-results/**"
  ],
  "config": {
    "MD013": false,
    "MD034": false,
    "MD033": false,
    "MD060": false,
    "MD041": false,
    "MD036": false,
    "MD024": false,
    // MD037/MD050 --fix mis-detects bare Python identifiers in prose
    // (e.g. `_session_date`, `__init__.py` without backticks) as broken
    // emphasis/strong markup and corrupts them (2026-07-16, see PROBLEM_LOG).
    "MD037": false,
    "MD050": false
  }
}
