# Alpaca credentials (news + listing metadata; not the price/scanner feed)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_FEED=iex

# Local API auth (SEC-002 / SEC-004 / D-040).
# Required for POST /api/config even on loopback (rewrites .env).
# Required for all mutating /api/* when bound off loopback.
# Desktop sidecar auto-provisions this key in userData .env.
# Vite Settings: set the same value as VITE_NOVA_API_KEY in frontend/.env.local
#NOVA_API_KEY=
#NOVA_API_HOST=127.0.0.1
# Optional webhook host allowlist (comma-separated). Empty = any public https host.
#NOVA_WEBHOOK_HOST_ALLOWLIST=discord.com,discordapp.com
# CORS for deploys (local default is Vite localhost:5173 only)
#NOVA_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Scanner discovery is IBKR-only (gappers/gainers/losers via Gateway).
# Stale "alpaca" values are coerced to ibkr. See backend/ibkr/discovery.py.
NOVA_DISCOVERY_PROVIDER=ibkr

# Optional bootstrap for Sim practice (header Paper / Live / Sim is the live toggle).
# NOVA_BROKER=sim starts the process in Sim. Leave unset or ibkr for IBKR.
#NOVA_BROKER=ibkr

# Nova Desktop in-app updates (installed Windows app only, #347). On by default:
# shortly after launch the desk checks GitHub Releases, downloads a newer
# installer in the background, and asks -- Restart to update, or Later. It never
# installs or restarts on its own. 0 stops the automatic check (offline or
# locked-down desk); Help > Check for Updates still works.
#NOVA_UPDATE_CHECK=1

# Interactive Brokers (optional trading module — off by default)
# Set IBKR_ENABLED=true to activate. Requires IB Gateway running locally.
# IBKR_GATEWAY_MODE=paper|live selects port 4002 / 4001 (market data connection).
# Default is live (4001). The paper Gateway (4002) is legacy (ADR 020): by hand
# only via POST /api/ibkr/gateway-mode {"mode":"paper"}, never an automatic
# fallback -- beside a live login it is read-only and carries no tape.
# Follow-Gateway still attaches paper -> live when 4002 is dark and 4001 is up
# (and may persist .env). Disable with IBKR_GATEWAY_SELF_HEAL=false. Opt in to
# a live -> paper fallback with IBKR_PAPER_GATEWAY_FALLBACK=true. Spend gates
# never auto-unlock.
# After connect, managedAccounts must match the mode (live U… / paper DU… DF…)
# or Nova disconnects and refuses place. Port alone is not enough.
# IBKR_ORDERS_ENABLED=false (default) locks ALL buys/sells. Live money also
# needs IBKR_LIVE_TRADING_CONFIRMED=true. Paper orders: MODE=paper + ORDERS_ENABLED.
#IBKR_ENABLED=false
#IBKR_GATEWAY_MODE=live
#IBKR_GATEWAY_SELF_HEAL=true
#IBKR_PAPER_GATEWAY_FALLBACK=false
#IBKR_ORDERS_ENABLED=false
#IBKR_LIVE_TRADING_CONFIRMED=false
#IBKR_SHORT_ENABLED=false  # Phase K: third key to open shorts (paper or live)
# Test quantity gate (#444): the most shares one order may send, on every venue.
# Default 10 (IBKR_FORCE_ONE_SHARE_QTY). One line here changes the clamp, the
# /api/ibkr/status qty_cap field and the ticket's "sends N of M" copy together.
#IBKR_QTY_CAP=10
# Optional Cash vs Margin override. Gateway AccountType is ownership
# (INDIVIDUAL), not Cash vs Margin. Unset: tokens, then BP vs TotalCashValue
# (BP <= cash*1.15 -> Cash; BP >= cash*1.5 or BP >= ExcessLiquidity*1.5 -> Margin),
# else Cash. Connected desks never show Unknown. Ticket Short is Margin-only.
#IBKR_ACCOUNT_CLASS=cash
#IBKR_HOST=127.0.0.1
#IBKR_PAPER_PORT=4002
#IBKR_LIVE_PORT=4001
# Finnhub (Earnings calendar + optional Nova News headlines). Free tier:
# https://finnhub.io  Not a price/scanner feed.
# Missing key: Earnings shows a loud empty state. Nova News still loads
# AI-trading RSS; Finnhub just appears as a down source. Off-topic Finnhub
# rows are dropped -- they do not fill the desk.
#FINNHUB_API_KEY=

# Bot llm-decide pack (nova-brain). OpenRouter is the decision model.
# Reuses OPENROUTER_API_KEY below (same key as Advise). Live fire still
# needs L2 + header "Bot is in control" (Activate). Missing key = idle,
# never places. No paid LLM in CI.
# Optional overrides (defaults: OpenRouter + openai/gpt-4o-mini):
#NOVA_LLM_API_KEY=
#NOVA_LLM_BASE_URL=https://openrouter.ai/api/v1
#NOVA_LLM_MODEL=
#NOVA_BRAIN_MODEL=openai/gpt-4o-mini

# Advise rail (TradingAgents-style debate). Never sends orders.
# Required-for-full-power (new Run only; book reopen is free):
#OPENROUTER_API_KEY=
# Optional model override (default is Claude Sonnet latest via OpenRouter):
#ADVISE_OPENROUTER_MODEL=~anthropic/claude-sonnet-latest
# Optional vendors for richer News/Sentiment. Yahoo still supplies
# prices / fundamentals / technicals without these:
#ALPHA_VANTAGE_API_KEY=
#REDDIT_CLIENT_ID=
#REDDIT_CLIENT_SECRET=

# Optional Sentry (backend). Leave unset to disable.
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=local
#SENTRY_RELEASE=
#SENTRY_TRACES_SAMPLE_RATE=0.0

# Lincoln AI — optional LLM narrative for the news impact layer's
# ai_reasoning field (backend/news/ai_reasoning.py). Off by default (costs
# money via OPENAI_API_KEY below). FinBERT headline sentiment
# (backend/news/sentiment.py) needs no key and runs regardless.
#LINCOLN_AI_ENABLED=false

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cloudflare R2 — Nova OS P8 cold-archive durability (optional).
# Keys go in .env ONLY — never commit. See docs/r2-archive-setup.md.
#ARCHIVE_R2_ENABLED=false
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=nova-archive
# Optional: also enable hourly compact+upload loop
#ARCHIVE_MAINTENANCE_ENABLED=false

# Optional persistent historical replay trade archive directory.
# NOVA_SIM_HISTORY_DIR=F:\Nova\sim\_capture\historical
