# Alpaca credentials (required for Nova scanner — free, read-only)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_FEED=iex

# Local API auth (SEC-002 / SEC-004). Optional on loopback (127.0.0.1).
# Required when binding publicly (e.g. Docker/Railway --host 0.0.0.0).
# Frontend: set the same value as VITE_NOVA_API_KEY in frontend/.env.local
#NOVA_API_KEY=
#NOVA_API_HOST=127.0.0.1
# Optional webhook host allowlist (comma-separated). Empty = any public https host.
#NOVA_WEBHOOK_HOST_ALLOWLIST=discord.com,discordapp.com
# CORS for deploys (local default is Vite localhost:5173 only)
#NOVA_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Scanner discovery is IBKR-only (gappers/gainers/losers via Gateway).
# Stale "alpaca" values are coerced to ibkr. See backend/ibkr/discovery.py.
NOVA_DISCOVERY_PROVIDER=ibkr

# Interactive Brokers (optional trading module — off by default)
# Set IBKR_ENABLED=true to activate. Requires IB Gateway running locally.
# IBKR_GATEWAY_MODE=paper|live selects port 4002 / 4001 (market data connection).
# PAPER PIN: when MODE=paper, Nova never self-heals onto the live port (4001).
# If MODE=live and 4001 is down but paper 4002 accepts, self-heal may flip to
# paper and persist .env. Disable with IBKR_GATEWAY_SELF_HEAL=false.
# After connect, managedAccounts must look like paper (DU…/DF…) when MODE=paper
# or Nova disconnects and refuses place. Port alone is not enough.
# IBKR_ORDERS_ENABLED=false (default) locks ALL buys/sells — use live Gateway for
# Level 2 safely. To place paper orders: GATEWAY_MODE=paper + ORDERS_ENABLED=true
# + connected paper accounts. Live money also needs IBKR_LIVE_TRADING_CONFIRMED=true.
#IBKR_ENABLED=false
#IBKR_GATEWAY_MODE=paper
#IBKR_GATEWAY_SELF_HEAL=true
#IBKR_ORDERS_ENABLED=false
#IBKR_LIVE_TRADING_CONFIRMED=false
#IBKR_HOST=127.0.0.1
#IBKR_PAPER_PORT=4002
#IBKR_LIVE_PORT=4001
# Optional Sentry (backend). Leave unset to disable.
#SENTRY_DSN=
#SENTRY_TRACES_SAMPLE_RATE=0.0

# Lincoln AI — optional LLM narrative for the news impact layer's
# ai_reasoning field (backend/news/ai_reasoning.py). Off by default (costs
# money via OPENAI_API_KEY below). FinBERT headline sentiment
# (backend/news/sentiment.py) needs no key and runs regardless.
#LINCOLN_AI_ENABLED=false

# Course PDF long-term memory (Pinecone RAG) — tools/course_memory/
PINECONE_API_KEY=
PINECONE_INDEX=nova-warrior-courses
#PINECONE_HOST=
PINECONE_NAMESPACE=warrior-slides
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cloudflare R2 — Nova OS P8 cold-archive durability (optional).
# Keys go in .env ONLY — never commit. See docs/r2-archive-setup.md.
#ARCHIVE_R2_ENABLED=false
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=nova-archive
# Optional: also enable hourly compact+upload loop
#ARCHIVE_MAINTENANCE_ENABLED=false
